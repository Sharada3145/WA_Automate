# Database Configuration
# PostgreSQL connection string for Prisma
DATABASE_URL="postgresql://user:password@localhost:5432/whatsapp_automation"

# Security
# Secret for signing JWT tokens (should be a long, random string in production)
JWT_SECRET="your-super-secret-jwt-key"
JWT_EXPIRES_IN="24h"

# WhatsApp Cloud API Configuration
# Enable mock mode when real credentials are not available
# When true, the system skips hitting the Meta API but processes database state normally
USE_MOCK_WHATSAPP="true"

# Meta API Version (e.g. v21.0)
WHATSAPP_API_VERSION="v21.0"
WHATSAPP_API_BASE_URL="https://graph.facebook.com"

# The System User Access Token from Meta Developer Console
WHATSAPP_ACCESS_TOKEN="your-system-user-access-token"

# The Business Account ID (WABA ID)
WHATSAPP_BUSINESS_ACCOUNT_ID="your-waba-id"

# The App Secret used to verify webhook signatures (X-Hub-Signature-256)
WHATSAPP_APP_SECRET="your-meta-app-secret"

# The custom verify token you configure in the Meta App Dashboard for webhooks
WHATSAPP_WEBHOOK_VERIFY_TOKEN="your-custom-webhook-verify-token"

# Redis / BullMQ Configuration
# Enable mock mode if Redis is not installed locally
USE_MOCK_REDIS="true"
REDIS_URL="redis://localhost:6379"

# Queue / Worker Settings
# Number of concurrent jobs the campaign worker can process
CAMPAIGN_WORKER_CONCURRENCY="10"
# Milliseconds delay between message sends to prevent rate limits
MESSAGE_SEND_DELAY_MS="100"

# Media Upload Configuration
# Directory to store uploaded media files locally
MEDIA_UPLOAD_DIR="./uploads"
# Maximum file size in bytes (e.g. 16MB)
MAX_MEDIA_FILE_SIZE="16777216"

# Rate Limiting
# Window in milliseconds for rate limiting (e.g. 1 minute)
RATE_LIMIT_WINDOW_MS="60000"
# Max requests per window per IP
RATE_LIMIT_MAX="100"

# Audit Logging
# Number of days to retain audit logs
AUDIT_LOG_RETENTION_DAYS="90"
